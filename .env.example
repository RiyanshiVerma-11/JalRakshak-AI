# ==============================================================================
# 🌊 JalRakshak AI — Environment Variables & AWS Configuration Template
# ==============================================================================
# HOW TO USE:
# 1. Copy this template to a new file named .env:
#      Windows: copy .env.example .env
#      Mac/Linux: cp .env.example .env
# 2. To run locally without AWS credentials, leave AWS_EXECUTION_MODE=HYBRID.
# 3. For live AWS cloud deployment, set AWS_EXECUTION_MODE=LIVE and fill in your keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME EXECUTION MODE
# ------------------------------------------------------------------------------
# HYBRID (Default):
#   - Zero AWS credentials required!
#   - Uses high-speed in-memory vector RAG, local incident state, and simulated
#     synthesizers with guaranteed NDMA 2024 deterministic fallback.
# LIVE:
#   - Connects directly to Amazon Bedrock, DynamoDB, EventBridge, and SNS via Boto3.
AWS_EXECUTION_MODE=HYBRID

# ------------------------------------------------------------------------------
# 2. AWS CREDENTIALS & REGION (Required only if AWS_EXECUTION_MODE=LIVE)
# ------------------------------------------------------------------------------
# Where to get your AWS Access Keys:
# 👉 AWS IAM Security Credentials: https://us-east-1.console.aws.amazon.com/iam/home#/security_credentials
#    (Under "Access keys" -> click "Create access key")
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# Target AWS Region (Default: Asia Pacific Mumbai - ap-south-1)
# 👉 AWS Region Selector: https://ap-south-1.console.aws.amazon.com
AWS_DEFAULT_REGION=ap-south-1
AWS_REGION=ap-south-1

# Your 12-digit AWS Account ID (Found in top-right of AWS Console navbar)
AWS_ACCOUNT_ID=123456789012

# Optional: Session Token (Only needed if using AWS Academy, Learner Lab, or AWS STS)
# AWS_SESSION_TOKEN=your_temporary_session_token_here

# ------------------------------------------------------------------------------
# 3. AMAZON BEDROCK (Foundation Model Inference)
# ------------------------------------------------------------------------------
# Model Access Setup:
# 👉 Request Anthropic Claude 3.5 Sonnet access here:
#    https://ap-south-1.console.aws.amazon.com/bedrock/home?region=ap-south-1#/modelaccess
# 👉 Supported Bedrock Model IDs:
#    https://docs.aws.amazon.com/bedrock/latest/userguide/model-ids.html
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# ------------------------------------------------------------------------------
# 4. AMAZON DYNAMODB STATE TABLES
# ------------------------------------------------------------------------------
# These tables are automatically provisioned by deploying aws_infra/template.yaml:
# 👉 DynamoDB Console: https://ap-south-1.console.aws.amazon.com/dynamodbv2/home?region=ap-south-1#tables
INCIDENTS_TABLE=JalRakshak-IncidentsTable
RESOURCES_TABLE=JalRakshak-ResourcesTable
CITIZEN_REPORTS_TABLE=JalRakshak-CitizenReportsTable
AUDIT_LOG_TABLE=JalRakshak-AuditLogTable

# ------------------------------------------------------------------------------
# 5. AMAZON EVENTBRIDGE & SNS MULTILINGUAL BROADCAST
# ------------------------------------------------------------------------------
# 👉 EventBridge Buses Console: https://ap-south-1.console.aws.amazon.com/events/home?region=ap-south-1#/eventbuses
EVENTBRIDGE_BUS=jalrakshak-emergency-eventbus
EVENT_BUS_NAME=jalrakshak-emergency-eventbus

# 👉 Amazon SNS Topics Console: https://ap-south-1.console.aws.amazon.com/sns/v3/home?region=ap-south-1#/topics
# Replace with your deployed SNS Topic ARN:
SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:123456789012:JalRakshak-Alerts-Multilingual

# ------------------------------------------------------------------------------
# 6. AMAZON S3 EVIDENCE LAKE
# ------------------------------------------------------------------------------
# 👉 Amazon S3 Console: https://s3.console.aws.amazon.com/s3/home?region=ap-south-1
S3_BUCKET_NAME=jalrakshak-evidence-ap-south-1
EVIDENCE_BUCKET=jalrakshak-evidence-ap-south-1

# ------------------------------------------------------------------------------
# 7. LOCAL APPLICATION SERVER SETTINGS
# ------------------------------------------------------------------------------
PORT=8004
HOST=127.0.0.1
